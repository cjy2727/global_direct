# Copy to .env; keep actual keys out of Git. Recreate container after changes.
AI_ENABLED=false
AI_PROVIDER=openai
# Select a model available to your API project, supporting Responses structured outputs.
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2000
AI_CONCURRENCY=1
AI_TIMEOUT_SECONDS=20
AI_BROWSER_MAX_STEPS=8
AI_BROWSER_TIMEOUT_SECONDS=40
AI_DAILY_REQUEST_LIMIT=100
# USD, UTC day. Zero disables paid calls; failures retain a conservative reservation.
AI_DAILY_BUDGET=1
# Set current model prices before enabling AI. Zero skips calls safely.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
ANALYSIS_CONCURRENCY=1
ANALYSIS_TIMEOUT_SECONDS=60
QUEUE_MAX_LENGTH=20
QUEUE_WAIT_TIMEOUT_SECONDS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP_PER_MINUTE=10
RATE_LIMIT_PER_USER_PER_MINUTE=10
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
JOB_RESULT_TTL_SECONDS=600
RESULT_MAX_ENTRIES=500
